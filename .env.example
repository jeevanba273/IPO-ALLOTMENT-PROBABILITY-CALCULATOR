# Copy to .env at the repo root for local development. .env is git-ignored.
# On Railway, set these as service variables instead.

# --- Secrets ---------------------------------------------------------------
INDIANAPI_KEY=
IPOALERTS_KEY=
# Local, without Docker: `ipo-intel serve` starts this Postgres for you.
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/ipo_intel
# Local, with Docker: the db service in docker-compose.yml
# DATABASE_URL=postgresql://ipo:ipo@localhost:5432/ipo_intel
# Telegram alerts: a bot token from @BotFather, then `ipo-intel telegram chats` for the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Sign-in for the dashboard. Required when it is reachable beyond this machine (Railway).
DASHBOARD_PASSWORD=

# --- Optional ------------------------------------------------------------------
# DASHBOARD_USER=admin
# Public address of the dashboard, used for links in Telegram alerts.
# DASHBOARD_URL=https://your-app.up.railway.app
# ipoalerts budget. Must stay below the plan's 25/day and 750/month.
# IPOALERTS_DAILY_CAP=20
# IPOALERTS_MONTHLY_CAP=700
# Share of the daily cap the GMP backfill may use (at most). Live polls go first.
# IPOALERTS_BACKFILL_DAILY_CAP=8
# IndianAPI remaining-request thresholds (from GET /usage).
# INDIANAPI_PAUSE_BACKFILL_BELOW=1000
# INDIANAPI_ESSENTIAL_ONLY_BELOW=300
# Backfill of listed IPOs: how many per run, seconds between calls.
# INDIANAPI_BACKFILL_LIMIT=50
# INDIANAPI_BACKFILL_PACE_SECONDS=3
# Days without bidding dates before an upcoming IPO counts as dormant.
# DORMANT_AFTER_DAYS=30
# HTTP_TIMEOUT_SECONDS=20
# HTTP_MAX_RETRIES=3
# HTTP_BACKOFF_BASE_SECONDS=1
# HTTP_BACKOFF_MAX_SECONDS=30
# LOG_LEVEL=INFO
# RULES_PATH=/app/config/rules_v1.yaml
# MIGRATIONS_DIR=/app/migrations

# --- Tests only --------------------------------------------------------------
# Tests start a throwaway Postgres on their own. To use your own server instead,
# export this in your shell (not in .env). The database name must contain
# "test" because its tables get truncated, and the role needs CREATEDB.
# TEST_DATABASE_URL=postgresql://ipo:ipo@localhost:5432/ipo_intel_test
